# ==============================================================================
# FAIRGIG WEB APPLICATION ENVIRONMENT TEMPLATE (.env.example)
# NOTICE: NEVER EXPOSE SUPABASE SERVICE ROLE KEYS TO THE FRONTEND
# ==============================================================================

# Public Supabase Client Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Backend Service API Base URLs
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_EARNINGS_SERVICE_URL=http://localhost:8002
NEXT_PUBLIC_ANOMALY_SERVICE_URL=http://localhost:8003
NEXT_PUBLIC_ANALYTICS_SERVICE_URL=http://localhost:8004
NEXT_PUBLIC_GRIEVANCE_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_CERTIFICATE_SERVICE_URL=http://localhost:4002
