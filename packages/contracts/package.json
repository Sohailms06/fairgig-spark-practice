{
  "name": "@fairgig/contracts",
  "version": "0.1.0",
  "description": "Shared TypeScript types and Zod validation schemas for FairGig",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
