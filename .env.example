# ==============================================================================
# FAIRGIG ROOT ENVIRONMENT TEMPLATE (.env.example)
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING SENSITIVE SECRETS
# ==============================================================================

# Supabase Infrastructure
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-private-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Private Evidence Storage Bucket
SUPABASE_STORAGE_BUCKET_EVIDENCE=evidence-private

# Security & Authentication
JWT_SECRET=super-secret-jwt-signing-key-min-32-chars-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Service Port Configuration
PORT_AUTH=8001
PORT_EARNINGS=8002
PORT_ANOMALY=8003
PORT_ANALYTICS=8004
PORT_GRIEVANCE=4001
PORT_CERTIFICATE=4002
PORT_WEB=3000

# Client Application URL
FRONTEND_URL=http://localhost:3000

# K-Anonymity Minimum Group Size Safeguard
MIN_K_ANONYMITY_GROUP_SIZE=5
